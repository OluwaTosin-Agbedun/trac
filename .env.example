# Copy to .env.local for local overrides. Never commit real values.
# With no DATABASE_URL, local development uses an empty local database (PGlite) under .data/.
# The first visit to /admin opens the one-time setup; then upload the tracker in the Import centre.

# --- Neon (production) -------------------------------------------------------------------
# App runtime: the POOLED connection string for the unprivileged login role (nut_app),
# never the owner. See db/migrations/0000_platform.sql for creating nut_app.
DATABASE_URL=
# Migrations only (npm run db:migrate): the DIRECT (unpooled) owner connection string.
MIGRATION_DATABASE_URL=
# Small pool on top of Neon's pooler.
DATABASE_POOL_MAX=5

# --- Sessions and first run --------------------------------------------------------------
# 32+ random characters, e.g. `openssl rand -base64 48`. Required whenever DATABASE_URL is set.
SESSION_SECRET=
# Required for multi-instance or self-hosted deploys (base64 of 32 bytes).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# One-time setup on a deployed site asks for this value (32+ random characters), so nobody else
# can claim the first administrator account. Not needed with the local database.
SETUP_TOKEN=

# --- Hosting ----------------------------------------------------------------------------
# Mount under an existing site route, e.g. /tracker. Leave empty for root. Public (inlined at build).
NEXT_PUBLIC_BASE_PATH=
# The site's public address, used in invitation links instead of request headers, e.g. https://tracker.example.org
SITE_URL=
# A header your host sets to the visitor's address and visitors cannot forge, for sign-in limits,
# e.g. x-vercel-forwarded-for (Vercel) or cf-connecting-ip (Cloudflare). Empty: last X-Forwarded-For entry.
CLIENT_IP_HEADER=

# --- Local only ---------------------------------------------------------------------------
# Opt in to the local database under `next start` (production mode) on your own machine. Never set in hosting.
LOCAL_DATABASE=
# Alternative location for the local PGlite data directory.
LOCAL_DB_DIR=

# --- Research assistant (Phase 3) ---------------------------------------------------------
# Server-side only, on whatever runs scans (the worker service in production; this server with the
# local database). Without it scans stop with "Configuration required".
ANTHROPIC_API_KEY=
# The worker service's own connection string (login role nut_worker_app, see 0006_research.sql).
WORKER_DATABASE_URL=
