{
  "name": "nigerian-university-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "node --test \"tests/db/*.test.mjs\"",
    "test:import": "node --test \"tests/import/*.test.mjs\"",
    "test": "node --test \"tests/db/*.test.mjs\" \"tests/import/*.test.mjs\" \"tests/lib/*.test.mjs\" \"tests/research/*.test.mjs\" && node --conditions=react-server --test \"tests/server/*.test.mjs\"",
    "import:preview": "node scripts/import-preview.ts",
    "db:migrate": "node scripts/db.ts migrate",
    "db:status": "node scripts/db.ts status",
    "db:reset-local": "node scripts/db.ts reset-local",
    "db:init-local": "node scripts/db.ts init-local",
    "check:secrets": "node scripts/security-check.mjs repo",
    "check:bundle": "node scripts/security-check.mjs bundle",
    "test:server": "node --conditions=react-server --test \"tests/server/*.test.mjs\"",
    "test:lib": "node --test \"tests/lib/*.test.mjs\"",
    "worker": "node scripts/research-worker.ts",
    "test:research": "node --test \"tests/research/*.test.mjs\"",
    "import:tracker": "node scripts/import-tracker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module",
  "overrides": {
    "uuid": "^11.1.1"
  }
}
